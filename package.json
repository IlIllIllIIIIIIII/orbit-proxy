{
  "name": "scramjet-v2-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small self-hosted Scramjet V2 web proxy.",
  "scripts": {
    "build": "node scripts/build-static.js",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "wisp": "node wisp-server.js",
    "wisp:dev": "node --watch wisp-server.js",
    "check": "node --check server.js && node --check wisp-server.js && node --check public/js/app.js && node --check public/js/engine.js && node --check public/sw.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chemicaljs": "file:vendor/chemicaljs",
    "@mercuryworkshop/bare-mux": "2.1.9",
    "chemical-libcurl": "npm:@mercuryworkshop/libcurl-transport@1.5.2",
    "@mercuryworkshop/libcurl-transport": "^2.0.5",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mercuryworkshop/scramjet-utils": "0.0.3",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "express": "^5.1.0"
  },
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlIllIllIIIIIIII/orbit-proxy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IlIllIllIIIIIIII/orbit-proxy/issues"
  },
  "homepage": "https://github.com/IlIllIllIIIIIIII/orbit-proxy#readme"
}
